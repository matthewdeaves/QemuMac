#!/usr/bin/env bash
#
# Pre-push hook: runs the test suite before pushing.
# Install with: git config core.hooksPath .githooks
#

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

errors=0

# The suite already covers syntax, bash 3.2 constructs, GNU/BSD portability,
# JSON validity and behaviour, so there is nothing to duplicate here.
echo "Running test suite..."
if ! ./tests/run-tests.sh >/dev/null 2>&1; then
    echo ""
    echo "Test suite FAILED. Re-run for details:"
    echo "  ./tests/run-tests.sh"
    errors=$((errors + 1))
else
    echo "Test suite... OK"
fi

# ShellCheck runs inside the test suite too; this repeats it only to surface
# the actual diagnostics rather than a bare pass/fail.
# Single source of truth: tests/shell-files.txt
SC_FILES=()
while IFS= read -r _f; do SC_FILES+=("$_f"); done < <(./tests/ci/shell-files.sh)
if command -v shellcheck >/dev/null 2>&1; then
    printf 'ShellCheck... '
    if shellcheck -S warning "${SC_FILES[@]}" >/dev/null 2>&1; then
        echo "OK"
    else
        echo "FAIL"
        shellcheck -S warning "${SC_FILES[@]}" 2>&1 | head -30
        errors=$((errors + 1))
    fi
else
    echo "ShellCheck... SKIPPED (not installed)"
fi

# Workflow YAML must stay parseable. A missing parser is a skip, not a
# failure - PyYAML is not part of a stock macOS python3.
WORKFLOW=".github/workflows/test-scripts.yml"
printf 'CI YAML... '
if python3 -c "import yaml" 2>/dev/null; then
    if python3 -c "import yaml,sys; yaml.safe_load(open(sys.argv[1]))" "$WORKFLOW" 2>/dev/null; then
        echo "OK"
    else
        echo "FAIL"
        errors=$((errors + 1))
    fi
elif command -v ruby >/dev/null 2>&1; then
    if ruby -ryaml -e 'YAML.safe_load(File.read(ARGV[0]), aliases: true)' "$WORKFLOW" 2>/dev/null; then
        echo "OK"
    else
        echo "FAIL"
        errors=$((errors + 1))
    fi
else
    echo "SKIPPED (no YAML parser)"
fi

if [[ $errors -gt 0 ]]; then
    echo ""
    echo "Pre-push checks FAILED (${errors}). Push aborted."
    exit 1
fi

echo "All pre-push checks passed."
